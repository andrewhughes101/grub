#!/bin/sh
# Remote repository setup script for grub_client
# This script is executed on the remote server via SSH
#
# Arguments:
#   $1 - Repository path on remote server (may contain ~)
#   $2 - Git binary directory path
#   $3 - Run ID (generated by client, passed through for consistency)
#   $4 - Target commit hash (HEAD on client)
#   $5 - Target branch name (active branch on client)
#   $6 - Target .gitattributes hash (from client repository)

repo_path="$1"
git_dir="$2"
run_id="$3"
target_commit="$4"
target_branch="$5"
target_gitattr_hash="$6"

# Output remote environment information for client to use
# These must be early outputs so client can capture them

# Output remote TMPDIR (defaults to /tmp if not set)
remote_tmpdir="${TMPDIR:-/tmp}"
echo "REMOTE_TMPDIR=$remote_tmpdir"

# Expand ~ if present and output the expanded path
eval expanded_path="$repo_path"
echo "EXPANDED_PATH=$expanded_path"
repo_path="$expanded_path"

if [ -n "$git_dir" ] && [ -d "$git_dir" ]; then
  GIT="$git_dir/git"
else
  GIT="git"
fi

# Check if .git directory exists (faster than git rev-parse)
# Note: repo_path is already expanded by eval in grub_client
if [ -d "$repo_path/.git" ]; then
  cd "$repo_path" || exit 1

  # Check if .gitattributes has changed between client and server
  # On z/OS, file encoding tags (zos-working-tree-encoding) are only applied on checkout.
  # If .gitattributes changes, we must recreate the repository so all files are tagged correctly.
  remote_gitattr_hash=$("$GIT" hash-object .gitattributes 2>/dev/null)
  remote_gitattr_hash="${remote_gitattr_hash:-none}"

  if [ -n "$target_gitattr_hash" ] && [ "$remote_gitattr_hash" != "$target_gitattr_hash" ]; then
    cd "$HOME" 2>/dev/null || cd /
    rm -rf "$repo_path"
    mkdir -p "$repo_path" && \
    cd "$repo_path" && \
    "$GIT" init && \
    "$GIT" config --local receive.denyCurrentBranch updateInstead && \
    "$GIT" config --local core.compression 6 && \
    "$GIT" config --local pack.compression 6 && \
    "$GIT" config --local protocol.version 2 && \
    echo "PUSH_NEEDED=1" && \
    echo "REPO_RECREATED" || echo "CREATE_FAILED"
  else
    # Git repository exists and attributes match - clean working directory with hard reset
    # Use reset --hard to discard all changes, then clean ALL files (including ignored ones)
    "$GIT" reset --hard HEAD >/dev/null 2>&1 || true
    "$GIT" clean -fdx >/dev/null 2>&1 || true

    # Check if remote HEAD commit and branch match target
    remote_commit=$("$GIT" rev-parse HEAD 2>/dev/null)
    remote_branch=$("$GIT" rev-parse --abbrev-ref HEAD 2>/dev/null)

    if [ -n "$target_commit" ] && [ "$remote_commit" = "$target_commit" ] && [ "$remote_branch" = "$target_branch" ]; then
      echo "PUSH_NEEDED=0"
    else
      echo "PUSH_NEEDED=1"
    fi

    # Only set git config if not already configured
    current_compression=$("$GIT" config --local core.compression 2>/dev/null)
    if [ "$current_compression" != "6" ]; then
      "$GIT" config --local core.compression 6 && \
      "$GIT" config --local pack.compression 6 && \
      "$GIT" config --local protocol.version 2 && \
      echo "REPO_CLEANED_CONFIGURED"
    else
      echo "REPO_CLEANED"
    fi
  fi
else
  # Repository does not exist or is not a git repository - create, initialize, and configure
  mkdir -p "$repo_path" && \
  cd "$repo_path" && \
  "$GIT" init && \
  "$GIT" config --local receive.denyCurrentBranch updateInstead && \
  "$GIT" config --local core.compression 6 && \
  "$GIT" config --local pack.compression 6 && \
  "$GIT" config --local protocol.version 2 && \
  echo "PUSH_NEEDED=1" && \
  echo "REPO_CREATED" || echo "CREATE_FAILED"
fi
