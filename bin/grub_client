#!/bin/bash

# grub_client: grub --help for syntax
# Get git hash from GRUB's directory, not the user's current directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GRUB_ROOT="$(dirname "$SCRIPT_DIR")"

# Source the YAML parser (grub_yaml_get_flat, grub_yaml_get_host)
. "${SCRIPT_DIR}/grub_yaml"
GIT_HASH=$(cd "$GRUB_ROOT" && git rev-parse --short=7 HEAD 2>/dev/null)
if [ -n "$GIT_HASH" ]; then
  VERSION="0.3.0+${GIT_HASH}"
else
  VERSION="0.3.0"
fi

syntax()
{
  echo "\
Usage: grub_client [options] <server> [build_command]

Options:
  -v | --verbose              : print verbose output
  -h | --help                 : print this usage information
  -o | --output               : print the stdout and stderr returned from the remote
  --version                   : print version information
  --repo-path <path>          : path to repository (default: current directory)
  --server-root <path>        : remote root directory (default: ~/dev)
  --git-dir <path>            : git directory on server (default: auto-detect by platform)
  -i | --inventory <file>     : Ansible inventory file to read host variables from
  -e | --extra-vars <file>    : YAML file of variables to set as env vars during build
  --no-multiplex              : disable SSH connection multiplexing (ControlMaster)
  --clear-cache <server>      : clear cached git directory and multiplex socket for server

Arguments:
  server         : ssh host specification (name must match host in inventory or ~/.ssh/config)
  build_command  : command to run on server (default: ./build)

Inventory:
  grub_client can read host variables from an Ansible-compatible inventory.
  Supported formats:
    -i | --inventory <file> : Ansible inventory YAML (all.hosts.<server>.*)
    host_vars/<server>.yml in the current directory (auto-discovered)

Extra vars:
  -e | --extra-vars <file> passes a flat YAML key/value file to the remote build as
  environment variables. Variables are set only for the build command and are
  not visible client-side or during patch application.
  Keys must be valid shell identifiers (letters, digits, underscores; no leading digit).
  Example file:
    MY_API_KEY: s3cr3t
    BUILD_FLAGS: --release --verbose

  Supported host variables:
    ansible_host                 : remote hostname or IP (overrides SSH config HostName)
    ansible_user                 : remote username (overrides SSH config User)
    ansible_ssh_private_key_file : SSH key path (overrides SSH config IdentityFile)
    ansible_port                 : remote SSH port (overrides SSH config Port)
    ansible_ssh_common_args      : additional SSH options (e.g. -o ProxyJump=...)
    grub_ssh_multiplex           : set to false to disable SSH connection multiplexing
    grub_server_root             : equivalent to --server-root
    grub_git_dir                 : equivalent to --git-dir

  Precedence:
    Host/SSH config : CLI args > inventory host vars > ~/.gitconfig cache > ~/.ssh/config > auto-detect defaults
    Build variables : inline command args (e.g. VAR=val ./build) > --extra-vars YAML file > remote shell env

Examples:
  1. Build current directory repository (uses defaults):
     cd /path/to/myrepo
     grub_client myserver

  2. Build with custom build command:
     grub_client myserver make

  3. Build specific repository:
     grub_client --repo-path \$HOME/projects/myapp myserver

  4. Override server root directory:
     grub_client --server-root /u/user/projects myserver

  5. Override git directory (for non-standard installations):
     grub_client --git-dir /opt/git/bin myserver

  6. Use an Ansible inventory file:
     grub_client --inventory ~/ansible/inventory.yml myzos

  7. Auto-discover host_vars (place host_vars/myzos.yml in current directory):
     grub_client myzos

  8. From VSCode (uses workspace folder automatically):
     grub_client --repo-path \${workspaceFolder} myserver

  9. Pass local environment variable to build command:
     grub_client myserver RELEASE_TAG=\$VERSION ./build

  10. Evaluate remote environment variable on server:
     grub_client myserver 'PATH=\$PATH:/opt/tools/bin ./build'

Environment Variables:
  TMPDIR : temporary directory for local files (default: /tmp)
           Remote server also honors TMPDIR for its temporary files

Environment Variables in Build Commands:
  - Local client variables: unquoted or double-quoted references (e.g. ARG=\$LOCAL_VAR)
    are expanded by your local shell before being passed to grub_client.
  - Remote server variables: single-quoted references (e.g. 'PATH=\$PATH:/opt/bin ./build')
    are preserved literally and evaluated on the remote server at runtime.
  - Structured variables: use -e / --extra-vars <file> to securely export key/value pairs
    into the remote build environment.

Defaults:
  - server_root: ~/dev (expands to remote user's home directory)
  - git_dir: /usr/lpp/IBM/foz/v1r1/bin (z/OS) or /usr/bin (other platforms)
  - build_command: ./build

Notes:
  - Repository name is automatically extracted from the path
  - Platform detection happens on the remote server
  - grub_client uses git and ssh to communicate with the remote server
  - ssh should be configured with public/private key authentication
  - grub_server script is automatically transferred to the remote server
" >&2
}

reset_origin_url()
{
  active_origin_url=$1

  # switch back to origin url that was active before build
  git config remote.origin.url "${active_origin_url}"
  if [ $? -gt 0 ]; then
    echo "Error: Problems trying to update remote.origin.url to ${active_origin_url}" >&2
    exit 4
  fi
  git config "branch.${active_branch}.remote" "${active_origin_url}"
  if [ $? -gt 0 ]; then
    echo "Error: Problems trying to update branch.${active_branch}.remote to ${active_origin_url}" >&2
    exit 4
  fi
}

vecho()
{
  if [ "${verbose}" = "True" ]; then
    echo "$*"
  fi
}

# Function to push to remote repository
push_to_remote()
{
  local server_repo=$1
  local detached=$2
  local branch_name=$3

  # Push with --force to overwrite remote state
  # The server will only keep what we push due to receive.denyCurrentBranch updateInstead
  if [ $detached -gt 0 ]; then
    vecho "On detached HEAD, pushing using temporary branch '$branch_name'"
    git branch $branch_name 2>/dev/null || true  # Branch might already exist
    if [ "${verbose}" = "True" ]; then
      git push --force --verbose -u "${server_repo}" $branch_name
    else
      git push --force -u "${server_repo}" $branch_name >/dev/null 2>&1
    fi
  else
    if [ "${verbose}" = "True" ]; then
      git push --force --verbose "${server_repo}"
    else
      git push --force "${server_repo}" >/dev/null 2>&1
    fi
  fi

  return $?
}

# Cleanup function called on exit via trap
cleanup()
{
  # Don't call exit here - just do cleanup and return
  # The original exit code will be preserved

  # Clean up local patch file if it exists
  if [ -n "$patch_file" ] && [ -f "$patch_file" ]; then
    rm -f "$patch_file" 2>/dev/null || true
  fi

  # Clean up local env file if it exists
  if [ -n "$local_env_file" ] && [ -f "$local_env_file" ]; then
    rm -f "$local_env_file" 2>/dev/null || true
  fi

  # Clean up remote patch file if it exists
  if [ -n "$server" ] && [ -n "$remote_patch_file" ]; then
    ssh $ssh_opts "${server}" "rm -f ${remote_patch_file}" 2>/dev/null || true
  fi

  # Clean up temporary branch if we made one
  if [ -n "$DETACHED" ] && [ $DETACHED -gt 0 ] && [ -n "$DETACHED_BRANCH_NAME" ]; then
    git branch -D $DETACHED_BRANCH_NAME 2>/dev/null || true
  fi

  # Clean up the remote we added
  if [ -n "$server" ] && [ -n "$repo" ]; then
    git remote remove "${server}_${repo}" 2>/dev/null || true
  fi
}

#set -x

# Set up trap to ensure cleanup on exit
trap cleanup EXIT INT TERM

# Parse options
verbose=False
output=False
repo_path=""
server_root=""  # Will be set from inventory or defaulted after server is known
git_dir=""      # Will be auto-detected if not specified
inventory_file=""
extra_vars_file=""
no_multiplex=False
server=""
build_command_parts=()

while [[ $# -gt 0 ]]; do
  # If a build command has already started, all remaining args belong to the build command
  if [ ${#build_command_parts[@]} -gt 0 ]; then
    build_command_parts+=("$1")
    shift
    continue
  fi

  case "$1" in
    -v|--verbose)
      verbose=True
      shift
      ;;
    -o|--output)
      output=True
      shift
      ;;
    --no-multiplex)
      no_multiplex=True
      shift
      ;;
    --repo-path)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --repo-path requires a path argument" >&2
        exit 4
      fi
      repo_path="$2"
      shift 2
      ;;
    --server-root)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --server-root requires a path argument" >&2
        exit 4
      fi
      server_root="$2"
      shift 2
      ;;
    --git-dir)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --git-dir requires a path argument" >&2
        exit 4
      fi
      git_dir="$2"
      shift 2
      ;;
    -i|--inventory)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --inventory requires a file path" >&2
        exit 4
      fi
      if [ ! -f "$2" ]; then
        echo "Error: --inventory file not found: $2" >&2
        exit 4
      fi
      inventory_file="$2"
      shift 2
      ;;
    -e|--extra-vars)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --extra-vars requires a file path" >&2
        exit 4
      fi
      if [ ! -f "$2" ]; then
        echo "Error: --extra-vars file not found: $2" >&2
        exit 4
      fi
      extra_vars_file="$2"
      shift 2
      ;;
    --clear-cache)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --clear-cache requires a server name" >&2
        exit 4
      fi
      git config --global --unset "grub.$2.gitdir" 2>/dev/null
      _cc_user=$(whoami)
      ssh -O exit -o "ControlPath=/tmp/grub_mux_${_cc_user}_$2.sock" "$2" 2>/dev/null || true
      rm -f "/tmp/grub_mux_${_cc_user}_$2.sock" 2>/dev/null || true
      echo "Cache cleared for server: $2"
      exit 0
      ;;
    -h|--help)
      syntax
      exit 0
      ;;
    --version)
      echo "grub_client version $VERSION"
      exit 0
      ;;
    --)
      shift
      if [ -z "$server" ] && [ $# -gt 0 ]; then
        server="$1"
        shift
      fi
      while [[ $# -gt 0 ]]; do
        build_command_parts+=("$1")
        shift
      done
      break
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      syntax
      exit 4
      ;;
    *)
      if [ -z "$server" ]; then
        server="$1"
      else
        build_command_parts+=("$1")
      fi
      shift
      ;;
  esac
done

if [ -z "$server" ]; then
  syntax
  exit 4
fi

if [ ${#build_command_parts[@]} -gt 0 ]; then
  build_command="${build_command_parts[*]}"
else
  build_command="./build"
fi

vecho "Server: $server"
vecho "Build command: $build_command"

#
# Load host variables from inventory (Ansible-compatible)
#
# Priority: CLI args > inventory host vars > ~/.gitconfig cache > auto-detect defaults
# ~/.ssh/config continues to work; ansible_host/user/key are passed as SSH -o options.
#

client_tmpdir="${TMPDIR:-/tmp}"
client_tmpdir="${client_tmpdir%/}"
local_user=$(whoami)

ssh_opts=""  # Extra SSH options built from inventory; appended to all ssh/scp/git-push calls

# Locate inventory source: --inventory flag takes precedence, then host_vars/<server>.yml
_inv_value() {
  # _inv_value <key>  — looks up key from whichever inventory source is active
  if [ -n "$inventory_file" ]; then
    grub_yaml_get_host "$inventory_file" "$server" "$1"
  elif [ -f "host_vars/${server}.yml" ]; then
    grub_yaml_get_flat "host_vars/${server}.yml" "$1"
  fi
}

# ansible_host — remote hostname/IP
_ansible_host=$(_inv_value ansible_host)
if [ -n "$_ansible_host" ]; then
  ssh_opts="$ssh_opts -o HostName=${_ansible_host}"
  vecho "Inventory: ansible_host=${_ansible_host}"
fi

# ansible_user — remote username
_ansible_user=$(_inv_value ansible_user)
if [ -n "$_ansible_user" ]; then
  ssh_opts="$ssh_opts -o User=${_ansible_user}"
  vecho "Inventory: ansible_user=${_ansible_user}"
fi

# ansible_ssh_private_key_file — SSH identity file
_ansible_key=$(_inv_value ansible_ssh_private_key_file)
if [ -n "$_ansible_key" ]; then
  # Expand ~ manually since SSH -i doesn't expand it in all implementations
  _ansible_key="${_ansible_key/#\~/$HOME}"
  ssh_opts="$ssh_opts -i ${_ansible_key}"
  vecho "Inventory: ansible_ssh_private_key_file=${_ansible_key}"
fi

# ansible_port — remote SSH port
_ansible_port=$(_inv_value ansible_port)
if [ -n "$_ansible_port" ]; then
  ssh_opts="$ssh_opts -o Port=${_ansible_port}"
  vecho "Inventory: ansible_port=${_ansible_port}"
fi

# ansible_ssh_common_args — extra SSH arguments (ProxyJump, etc.)
_ansible_common_args=$(_inv_value ansible_ssh_common_args)
if [ -n "$_ansible_common_args" ]; then
  ssh_opts="$ssh_opts ${_ansible_common_args}"
  vecho "Inventory: ansible_ssh_common_args=${_ansible_common_args}"
fi

# grub_ssh_multiplex — allow disabling SSH multiplexing via inventory
_inv_multiplex=$(_inv_value grub_ssh_multiplex)

# grub_server_root — only apply if not already set by CLI --server-root
if [ -z "$server_root" ]; then
  _inv_server_root=$(_inv_value grub_server_root)
  if [ -n "$_inv_server_root" ]; then
    server_root="$_inv_server_root"
    vecho "Inventory: grub_server_root=${server_root}"
  else
    server_root='~/dev'
    vecho "Using default server_root: ${server_root}"
  fi
else
  vecho "Using CLI server_root: ${server_root}"
fi

# grub_git_dir — only apply if not already set by CLI --git-dir
if [ -z "$git_dir" ]; then
  _inv_git_dir=$(_inv_value grub_git_dir)
  if [ -n "$_inv_git_dir" ]; then
    git_dir="$_inv_git_dir"
    vecho "Inventory: grub_git_dir=${git_dir}"
  fi
fi

# SSH connection multiplexing (ControlMaster): share single SSH connection across all operations
# The socket path must stay under the OS limit for Unix domain sockets (~104 chars on macOS).
# $TMPDIR on macOS expands to a long /var/folders/… path, so use /tmp unconditionally for the
# socket file; /tmp is a symlink to /private/tmp on macOS and is always short.
if [ "$no_multiplex" != "True" ] && [ "$_inv_multiplex" != "false" ] && [ "$_inv_multiplex" != "False" ]; then
  mux_socket="/tmp/grub_mux_${local_user}_${server}.sock"
  ssh_opts="-o ControlMaster=auto -o ControlPath=${mux_socket} -o ControlPersist=600 $ssh_opts"
  vecho "SSH multiplexing enabled (socket: ${mux_socket})"
fi

# Propagate ssh_opts to git's SSH invocations (git push uses its own SSH subprocess)
if [ -n "$ssh_opts" ]; then
  export GIT_SSH_COMMAND="ssh ${ssh_opts}"
  vecho "GIT_SSH_COMMAND set: ${GIT_SSH_COMMAND}"
fi

# If git_dir not specified, detect it now (needed for git push configuration)
if [ -z "$git_dir" ]; then
  # Try to get cached value first
  cached_git_dir=$(git config --global --get "grub.${server}.gitdir" 2>/dev/null)

  if [ -n "$cached_git_dir" ]; then
    git_dir="$cached_git_dir"
    vecho "Using cached git_dir for ${server}: $git_dir"
  else
    vecho "Auto-detecting git directory on remote server..."
    # Check if remote is z/OS
    remote_uname=$(ssh $ssh_opts "${server}" "uname -s" 2>/dev/null)
    if echo "$remote_uname" | grep -qi "OS/390"; then
      git_dir="/usr/lpp/IBM/foz/v1r1/bin"
      vecho "Detected z/OS platform, using git_dir: $git_dir"
    else
      git_dir="/usr/bin"
      vecho "Detected non-z/OS platform, using git_dir: $git_dir"
    fi

    # Cache the detected value for future builds
    git config --global "grub.${server}.gitdir" "$git_dir"
    vecho "Cached git_dir for future use"
  fi
else
  vecho "Using specified git_dir: $git_dir"
fi

# Determine repository path
if [ -z "$repo_path" ]; then
  # Default to current working directory
  repo_path="$PWD"
  vecho "Using current directory as repository path: $repo_path"
fi

# Validate and normalize the repository path
if ! [ -d "$repo_path" ]; then
  echo "Error: Repository path '$repo_path' does not exist" >&2
  exit 8
fi

if ! cd "$repo_path" ; then
  echo "Unable to change into repository directory: $repo_path" >&2
  exit 8
fi

# Get absolute normalized path
repo_path=$(pwd -P)
vecho "Normalized repository path: $repo_path"

# Extract repository name from path
repo=$(basename "$repo_path")
vecho "Repository name: $repo"

vecho "Start:" $(date)
seconds_start=$(date '+%s')

# Generate a unique run identifier for this build - used throughout the entire flow
run_id="$(date +%Y%m%d_%H%M%S)_$$"
vecho "Run ID: $run_id"

active_origin_url=$(git config --get remote.origin.url)
if [ "${active_origin_url}" = '' ]; then
  echo "Error: Unable to retrieve current remote origin url" >&2
  exit 4
fi

# Note: Git remote configuration will be set up after grub_remote_setup
# so we can use the expanded server_root path from the remote

# Before pushing check if we're in a detached HEAD and push a temporary branch instead

git symbolic-ref -q HEAD >/dev/null 2>&1
DETACHED=$?
DETACHED_BRANCH_NAME="detached-head-branch"

if [ $DETACHED -gt 0 ]; then
  active_branch="$DETACHED_BRANCH_NAME"
else
  active_branch=$(git rev-parse --abbrev-ref HEAD)
  if [ $? -gt 0 ]; then
    echo "Unable to determine current local branch" >&2
    exit 8
  fi
fi

local_commit=$(git rev-parse HEAD 2>/dev/null)
local_gitattr_hash=$(git hash-object .gitattributes 2>/dev/null)
local_gitattr_hash="${local_gitattr_hash:-none}"
vecho "Local HEAD commit: $local_commit"
vecho "Local .gitattributes hash: $local_gitattr_hash"
vecho "Active branch: $active_branch"

# Check if there are unstaged changes and create a patch file if needed
patch_file="${client_tmpdir}/grub_${local_user}_${server}_${repo}.${run_id}.patch"
has_unstaged_changes=0

# Quick change detection before creating patch
if git diff-index --quiet HEAD -- && [ -z "$(git ls-files --others --exclude-standard)" ]; then
  # No changes at all - skip patch creation entirely (fast path)
  has_unstaged_changes=0
  vecho "No unstaged changes detected"
else
  # Changes exist - create patch file
  has_unstaged_changes=1
  vecho "Creating patch file for unstaged changes"

  # Create a patch that includes:
  # 1. Unstaged changes to tracked files
  # 2. Staged changes
  # 3. Untracked files
  {
    # First, output diff for tracked files (staged and unstaged) with standard prefixes
    git diff --src-prefix=a/ --dst-prefix=b/ --no-color HEAD

    # Add untracked files as new file patches with standard prefixes
    git ls-files --others --exclude-standard | while read -r file; do
      [ -f "$file" ] || continue
      git diff --no-index --src-prefix=a/ --dst-prefix=b/ --no-color /dev/null "$file" 2>/dev/null || true
    done
  } > "$patch_file"

  if [ ! -s "$patch_file" ]; then
    # Patch file is empty, no changes after all
    has_unstaged_changes=0
    rm -f "$patch_file"
  else
    vecho "Patch file created: $patch_file"
  fi
fi

seconds_patch=$(date '+%s')

#
# msf - If you are not using fast-forwarding, you may have to do a force-lease
# to publish your changes to github.ibm.com
# If you want to avoid this and are ok with it, you can do:
#   git config pull.ff true
# to specify fast-forwarding.
# You can also do it globally if you want, e.g.
#   git config --global pull.ff true
# See: https://thelinuxcode.com/use-pull-rebase-false-pull-ff-true-git/

#
# The --force-with-lease is required because we may have reset the head one or more times
# If you get a message about 'stale info' then this might require 'git remote prune origin'
# (msf - this particular 'git push' needs some more homework)
#
vecho "Synchronize changes from ${repo_path} to ${server}"
echo "Preparing remote repository..." >&2

# Batch SSH operations: clean existing repo OR create new one in single call

# Execute the remote setup script via SSH
# Pass run_id, local_commit, active_branch, and local_gitattr_hash to remote setup
# Use eval on remote to expand ~ in server_root
vecho "Requested remote repository path: ${server_root}/${repo}"
vecho "Remote setup git_dir: ${git_dir}"
batch_result=$(cat "${SCRIPT_DIR}/grub_remote_setup" | ssh $ssh_opts "${server}" "eval sh -s -- ${server_root}/${repo} '${git_dir}' '${run_id}' '${local_commit}' '${active_branch}' '${local_gitattr_hash}'" 2>&1)

batch_status=$?

# Extract values from the remote setup output
push_needed=$(echo "$batch_result" | grep "^PUSH_NEEDED=" | cut -d= -f2)
remote_tmpdir=$(echo "$batch_result" | grep "^REMOTE_TMPDIR=" | cut -d= -f2)
remote_tmpdir=${remote_tmpdir:-/tmp}
expanded_server_root=$(echo "$batch_result" | grep "^EXPANDED_PATH=" | cut -d= -f2)

if [ -z "$expanded_server_root" ]; then
  echo "Error: Failed to get expanded path from remote setup" >&2
  [ -n "$batch_result" ] && echo "$batch_result" >&2
  exit 4
fi

vecho "Remote TMPDIR: $remote_tmpdir"

# Extract just the parent directory (remove the repo name)
expanded_server_root=$(dirname "$expanded_server_root")
vecho "Using expanded server_root: $expanded_server_root"

# Now set up git remote configuration with the expanded path
url=$(git config --get "remote.${server}_${repo}.url")
if [ "${url}" = '' ]; then
  git remote add "${server}_${repo}" "${server}:${expanded_server_root}/${repo}"
  if [ $? -gt 0 ]; then
    echo "Error: Unable to set url for ${server}_${repo}" >&2
    exit 4
  fi
else
  # Update existing remote URL if it differs
  expected_url="${server}:${expanded_server_root}/${repo}"
  if [ "${url}" != "${expected_url}" ]; then
    git remote set-url "${server}_${repo}" "${expected_url}"
    if [ $? -gt 0 ]; then
      echo "Error: Unable to update url for ${server}_${repo}" >&2
      exit 4
    fi
  fi
fi

uploadpack=$(git config --get "remote.${server}_${repo}.uploadpack")
if [ "${uploadpack}" = '' ]; then
  git config --add "remote.${server}_${repo}.uploadpack" "${git_dir}/git-upload-pack"
  if [ $? -gt 0 ]; then
    echo "Error: Unable to add configuration for remote.${server}_${repo}.uploadpack" >&2
    exit 4
  fi
fi
receivepack=$(git config --get "remote.${server}_${repo}.receivepack")
if [ "${receivepack}" = '' ]; then
  git config --add "remote.${server}_${repo}.receivepack" "${git_dir}/git-receive-pack"
  if [ $? -gt 0 ]; then
    echo "Error: Unable to add configuration for remote.${server}_${repo}.receive-pack" >&2
    exit 4
  fi
fi

# Check if batched operation succeeded
if [ $batch_status -eq 0 ] && echo "$batch_result" | grep -qE "REPO_CLEANED|REPO_CREATED|REPO_RECREATED"; then
  # Golden path succeeded!
  if echo "$batch_result" | grep -q "REPO_RECREATED"; then
    vecho ".gitattributes changed: remote repository recreated to refresh encoding tags"
  elif echo "$batch_result" | grep -q "REPO_CLEANED_CONFIGURED"; then
    vecho "Repository cleaned and configured on server (batched operation)"
  elif echo "$batch_result" | grep -q "REPO_CLEANED"; then
    vecho "Repository cleaned on server (config already set - fast path)"
  else
    vecho "Repository created on server (batched operation)"
  fi

  # Push to remote only if needed (e.g. commit or branch changed, or new repo)
  if [ "$push_needed" = "0" ]; then
    vecho "Remote commit matches local HEAD ($local_commit). Skipping git push."
  else
    echo "Synchronizing with remote server..." >&2
    push_to_remote "${server}_${repo}" $DETACHED "$DETACHED_BRANCH_NAME"
    push_status=$?

    if [ $push_status -gt 0 ]; then
      echo "Error: Unable to push to ${server}_${repo} after successful repository preparation." >&2
      reset_origin_url "${active_origin_url}"
      exit 4
    fi
  fi
else
  # Batched operation failed - fall back to individual operations
  vecho "Preparing remote repository (alternative method)..."
  vecho "Remote setup status: $batch_result"

  # Fallback 1: Try to clean existing repository and configure compression + protocol v2
  vecho "Cleaning remote working directory..."
  ssh $ssh_opts "${server}" "cd ${server_root}/${repo} 2>/dev/null && ${git_dir}/git reset --hard HEAD >/dev/null 2>&1 && ${git_dir}/git clean -fdx >/dev/null 2>&1 && ${git_dir}/git config --local core.compression 6 && ${git_dir}/git config --local pack.compression 6 && ${git_dir}/git config --local protocol.version 2" 2>/dev/null || true

  # Fallback 2: Try to push to remote (suppress errors if repo doesn't exist yet)
  echo "Synchronizing with remote server..." >&2
  vecho "Attempting to push to remote repository..."
  push_to_remote "${server}_${repo}" $DETACHED "$DETACHED_BRANCH_NAME" 2>/dev/null

  if [ $? -gt 1 ]; then
    # Push failed - try to create repository with compression + protocol v2 configured
    vecho "Creating new repository ${repo} on ${server_root}..."
    ssh $ssh_opts "${server}" "mkdir -p ${server_root}/${repo} && cd ${server_root}/${repo} && ${git_dir}/git init && ${git_dir}/git config --local receive.denyCurrentBranch updateInstead && ${git_dir}/git config --local core.compression 6 && ${git_dir}/git config --local pack.compression 6 && ${git_dir}/git config --local protocol.version 2"
    if [ $? -gt 0 ]; then
      echo "Error: Failed to push to remote repo: ${server}_${repo} and attempt to create repository on server failed." >&2
      reset_origin_url "${active_origin_url}"
      exit 4
    fi

    # Retry push after setting up repository
    push_to_remote "${server}_${repo}" $DETACHED "$DETACHED_BRANCH_NAME"
    if [ $? -gt 0 ]; then
      echo "Error: Unable to push to ${server}_${repo}." >&2
      reset_origin_url "${active_origin_url}"
      exit 4
    fi
    vecho "Remote repository prepared successfully"
  else
    vecho "Remote repository prepared successfully"
  fi

  # Clean working directory after push to ensure 100% clean state
  vecho "Finalizing remote repository state..."
  ssh $ssh_opts "${server}" "cd ${server_root}/${repo} && ${git_dir}/git reset --hard HEAD >/dev/null 2>&1 && ${git_dir}/git clean -fdx >/dev/null 2>&1" 2>/dev/null || true
fi

seconds_sync=$(date '+%s')

vecho "Repository synchronized:" $(date)

# Restore origin URL
reset_origin_url "${active_origin_url}"

# Transfer patch file to server if we have unstaged changes
if [ $has_unstaged_changes -eq 1 ]; then
  vecho "Transferring patch file to server (compressed)"
  # Use remote TMPDIR with unique run ID
  remote_patch_file="${remote_tmpdir}/grub.${local_user}_${server}_${repo}.${run_id}.patch"

  scp -C -q $ssh_opts "$patch_file" "${server}:${remote_patch_file}"
  if [ $? -gt 0 ]; then
    echo "Error: Failed to transfer patch file to server" >&2
    exit 4
  fi
  vecho "Patch file transferred to ${server}:${remote_patch_file}"
fi

seconds_transfer=$(date '+%s')

vecho "Patch transfer complete:" $(date)

# Process and transfer extra-vars file if specified
remote_env_file=""
local_env_file=""
if [ -n "$extra_vars_file" ]; then
  if [ ! -f "$extra_vars_file" ]; then
    echo "Error: --extra-vars file not found: $extra_vars_file" >&2
    exit 4
  fi

  local_env_file="${client_tmpdir}/grub_${local_user}_${server}_${repo}.${run_id}.env"

  # Parse YAML into shell export statements, validating keys as legal identifiers
  parse_errors=0
  while IFS= read -r pair; do
    # pair is KEY='value' from grub_yaml_iter_flat
    key="${pair%%=*}"
    if ! echo "$key" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'; then
      echo "Error: --extra-vars: '$key' is not a valid shell identifier" >&2
      parse_errors=$((parse_errors + 1))
    else
      echo "export $pair" >> "$local_env_file"
    fi
  done < <(grub_yaml_iter_flat "$extra_vars_file")

  if [ $parse_errors -gt 0 ]; then
    echo "Error: --extra-vars file contains $parse_errors invalid key(s)" >&2
    exit 4
  fi

  if [ ! -s "$local_env_file" ]; then
    vecho "Warning: --extra-vars file produced no variables, ignoring"
    rm -f "$local_env_file"
    local_env_file=""
  else
    remote_env_file="${remote_tmpdir}/grub.${local_user}_${server}_${repo}.${run_id}.env"
    vecho "Transferring extra-vars env file to server"
    scp -C -q $ssh_opts "$local_env_file" "${server}:${remote_env_file}"
    if [ $? -gt 0 ]; then
      echo "Error: Failed to transfer extra-vars file to server" >&2
      exit 4
    fi
    vecho "Extra-vars file transferred to ${server}:${remote_env_file}"
  fi
fi

# Note: Git cleanup (remote, branch, patch) will be handled by trap on exit

# Execute grub_server - stream output to terminal and capture to temp file
# Pass has_unstaged_changes flag to server
remote_output_file="${client_tmpdir}/grub_${local_user}_${server}_${repo}.${run_id}_remote.out"

# Prepend a variable-assignment prologue to grub_server so arguments are passed as
# environment variables rather than positional parameters. SSH concatenates all
# post-hostname words into one shell string before the remote sh parses it, so
# positional args containing spaces (e.g. "TEST=21 ./build") get word-split and
# shift every subsequent $N. Variables are immune to that problem.
# Each value is single-quote-escaped so the prologue is safe to inline into the
# remote shell command string.
_q() { printf '%s' "$1" | sed "s/'/'\\''/g; s/^/'/; s/$/'/" ; }
prologue=$(printf '%s\n' \
  "GRUB_SERVER_ROOT=$(_q "${server_root}")" \
  "GRUB_REPO=$(_q "${repo}")" \
  "GRUB_GIT_DIR=$(_q "${git_dir}")" \
  "GRUB_BUILD_CMD=$(_q "${build_command}")" \
  "GRUB_SERVER_NAME=$(_q "${server}")" \
  "GRUB_HAS_PATCH=${has_unstaged_changes}" \
  "GRUB_USER=$(_q "${local_user}")" \
  "GRUB_BRANCH=$(_q "${active_branch}")" \
  "GRUB_REMOTE_TMPDIR=$(_q "${remote_tmpdir}")" \
  "GRUB_RUN_ID=$(_q "${run_id}")" \
  "GRUB_ENV_FILE=$(_q "${remote_env_file}")" \
)
{ printf '%s\n' "$prologue"; cat "${SCRIPT_DIR}/grub_server"; } \
  | ssh $ssh_opts "${server}" /bin/sh \
  | tee "$remote_output_file"
# Capture exit code of ssh command (middle of pipeline), not tee
ssh_command_exit=${PIPESTATUS[1]}

# Parse the captured output to extract the temp file paths
bld_out=$(grep "^GRUB_OUT=" "$remote_output_file" 2>/dev/null | cut -d= -f2)
bld_err=$(grep "^GRUB_ERR=" "$remote_output_file" 2>/dev/null | cut -d= -f2)

vecho ""
vecho "grub version: $VERSION"

if [ -z "$bld_out" ] || [ -z "$bld_err" ]; then
  echo "Error: Failed to retrieve remote temp file paths from grub_server output" >&2
  exit 4
fi

# Clean up the temporary output file only after successful parsing
rm -f "$remote_output_file"

if [ $ssh_command_exit -gt 0 ]; then
  echo "Remote build failed with exit code $ssh_command_exit" >&2
fi

seconds_build=$(date '+%s')

vecho "Build complete:" $(date)

#
# Download build output files using ssh+cat to avoid z/OS scp auto-conversion issues
# This bypasses scp's automatic EBCDIC-to-ASCII conversion which can scramble UTF-8 files
# client_tmpdir already set and normalized above
#
vecho "Downloading build output files (via ssh+cat)..."
ssh $ssh_opts "${server}" "cat ${bld_out}" > "${client_tmpdir}/$(basename "${bld_out}")" 2>/dev/null &
pid_out=$!
ssh $ssh_opts "${server}" "cat ${bld_err}" > "${client_tmpdir}/$(basename "${bld_err}")" 2>/dev/null &
pid_err=$!
wait ${pid_out} ${pid_err}
rc=$?
if [ $rc -gt 0 ]; then
  echo "Warning: Failed to download one or both of ${bld_out} and ${bld_err} from ${server}. rc ${rc}" >&2
  # Don't exit - try to show what we can
else
  # Successfully downloaded - clean up remote log files
  vecho "Cleaning up remote log files..."
  ssh $ssh_opts "${server}" "rm -f ${bld_out} ${bld_err}" 2>/dev/null || true
fi

seconds_download=$(date '+%s')

# Extract just the filename from the remote path for local reference
local_bld_out="${client_tmpdir}/$(basename "${bld_out}")"
local_bld_err="${client_tmpdir}/$(basename "${bld_err}")"

if [ -f "${local_bld_out}" ]; then
  out=$(cat ${local_bld_out})
  if [ "${out}" != "" ]; then
    vecho "Output downloaded to ${local_bld_out}"
  fi
else
  echo "Warning: Output file ${local_bld_out} not found" >&2
fi

if [ -f "${local_bld_err}" ]; then
  err=$(cat ${local_bld_err})
  if [ "${err}" != "" ]; then
    vecho "Errors downloaded to ${local_bld_err}"
    echo "${err}" >&2
  fi
else
  echo "Warning: Error file ${local_bld_err} not found" >&2
fi

seconds_finish=$(date '+%s')

vecho "Finish:" $(date)

vecho "Times: "
vecho " patch create:   " $((seconds_patch-seconds_start)) "s"
vecho " git sync:       " $((seconds_sync-seconds_patch)) "s"
vecho " patch transfer: " $((${seconds_transfer:-0}-seconds_sync)) "s"
vecho " remote build:   " $((${seconds_build:-0}-${seconds_transfer:-0})) "s"
vecho " download:       " $((${seconds_download:-0}-${seconds_build:-0})) "s"
vecho "Total time:      " $((seconds_finish-seconds_start)) "s"

if [ ${output} = "True" ]; then
  if [ -f "${local_bld_out}" ]; then
    echo "Output from ${local_bld_out}"
    cat "$local_bld_out"
  fi
  if [ -f "${local_bld_err}" ]; then
    echo "Errors from ${local_bld_err}"
    cat "$local_bld_err"
  fi
fi


# Use exit code of ssh command to exit script to determine overall exit code
# Cleanup will be handled by the trap handler
exit $ssh_command_exit
